<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fcu.emailintake</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>git -C /Users/leo-claude/fcu-cron pull --quiet --ff-only origin main; [ -f /Users/leo-claude/fcu-cron/bid-scanner/gmail_intake_token.json ] &amp;&amp; /Users/leo-claude/.pyenv/versions/3.11.9/bin/python3 /Users/leo-claude/fcu-cron/bid-scanner/email_intake.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner</string>

    <!-- info@ → Airtable every 15 min, around the clock. Does nothing until
         the one-time `python email_intake.py --auth` has saved a token. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/emailintake.cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/emailintake.cron.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
