<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fcu.jobwalk</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/Users/leo-claude/.pyenv/versions/3.11.9/bin/python3 /Users/leo-claude/fcu-cron/bid-scanner/pacific_schedule.py jobwalk 7 15 &amp;&amp; { git -C /Users/leo-claude/fcu-cron pull --quiet --ff-only origin main; /Users/leo-claude/.pyenv/versions/3.11.9/bin/python3 /Users/leo-claude/fcu-cron/bid-scanner/jobwalk.py; }</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>


    <key>WorkingDirectory</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner</string>

    <!-- Polls every 5 min; pacific_schedule.py gates the actual run to the
         first poll at/after 7:15 AM Mon-Fri Pacific time (see
         pacific_schedule.py — StartCalendarInterval isn't safe on this
         machine since the OS local-time display drifts). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/jobwalk.cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/jobwalk.cron.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
