<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fcu.scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/Users/leo-claude/.pyenv/versions/3.11.9/bin/python3 /Users/leo-claude/fcu-cron/bid-scanner/pacific_schedule.py scraper 6 0 &amp;&amp; { git -C /Users/leo-claude/fcu-cron pull --quiet --ff-only origin main; /Users/leo-claude/.pyenv/versions/3.11.9/bin/python3 /Users/leo-claude/fcu-cron/bid-scanner/main.py --headless; }</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>


    <key>WorkingDirectory</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner</string>

    <!-- Polls every 5 min; pacific_schedule.py gates the actual run to the
         first poll at/after 6:00 AM Mon-Fri Pacific time (computed via
         zoneinfo from UTC, immune to the OS's local-time display drifting -
         see pacific_schedule.py for why StartCalendarInterval isn't safe
         here). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/scraper.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/leo-claude/fcu-cron/bid-scanner/logs/scraper.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
