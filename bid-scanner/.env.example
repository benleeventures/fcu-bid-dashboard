# FCU Bid Scanner — environment config
# Copy to .env and fill in values

# Output directory for HTML reports
OUTPUT_DIR=./output

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_or_service_key

# PlanetBids vendor account (FCU) — per-portal scraping / intel scanner
PLANETBIDS_EMAIL=floorcoveringunltd@msn.com
PLANETBIDS_PASSWORD=your_password

# VendorLine (PlanetBids "Pro" plan) — aggregated bid search, no CAPTCHA.
# Replaces the daily per-portal PlanetBids run. Separate account from above.
VENDORLINE_EMAIL=your_vendorline_email
VENDORLINE_PASSWORD=your_vendorline_password

# Crisp Plan Room (username, not email)
CRISP_USER=your_crisp_username
CRISP_PASSWORD=your_crisp_password

# BidNet Direct
BIDNET_EMAIL=your_bidnet_email
BIDNET_PASSWORD=your_bidnet_password

# OpenGov procurement portal (Joanne's account)
OPENGOV_EMAIL=your_opengov_email
OPENGOV_PASSWORD=your_opengov_password

# SAM.gov API key — free at https://sam.gov → sign in → Profile → API key
# SAM_GOV_API_KEY=your_key_here

# ---------------------------------------------------------------
# Email notifications — Resend API (https://resend.com)
# ---------------------------------------------------------------

# Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender — must be a verified domain in Resend
FROM_EMAIL=FCU Bid Agent <bids@send.recenterlife.com>

# Public dashboard base URL — used for "View ↗" links in the digest emails.
# Defaults to https://bids.floorcoveringunlimited.com if unset.
DASHBOARD_URL=https://bids.floorcoveringunlimited.com

# Recipients by role — comma-separated for multiple addresses per var
REPORTS_EMAIL=                       # optional: scan summary, daily digest, cookie/supervisor alerts (blank = off)
BEN_EMAIL=ben@example.com            # job walks + new-bid alerts
JOANNE_EMAIL=joanne@example.com      # job walks + new-bid alerts + RFQ drafts
TEAM_EMAIL=shared@example.com        # shared inbox — job walks + new-bid alerts (optional)
ROBERT_EMAIL=robert@example.com      # job walks + new-bid alerts (optional)

# ADMIN_EMAIL is NOT read by the scanner — set it in Vercel only. It receives
# the scanner-down watchdog alert (app/api/cron/scanner-watchdog), nothing else.

# ---------------------------------------------------------------
# AI Parsing — Ollama (local LLM, optional)
# Run: ollama pull llama3  then: python parser.py --parse-all --ollama
# ---------------------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ---------------------------------------------------------------
# Telegram (optional fallback for cookie-expiry alerts)
# ---------------------------------------------------------------

# NOTIFY_TELEGRAM_TOKEN=your_bot_token
# NOTIFY_TELEGRAM_CHAT_ID=your_chat_id

# Geo LLM fallback (geo_llm.py) — locates relevant bids no structured source
# could place. Uses ANTHROPIC_API_KEY. GEO_LLM=off disables it.
# GEO_LLM=on
# GEO_LLM_MODEL=claude-opus-5-5        # claude-haiku-5-5 is cheaper
# GEO_LLM_MAX_PER_RUN=25

# Airtable owner by region (collaborator emails on the base). North -> Melvin
# (info@ until he has his own seat), South -> Robert. AIRTABLE_OWNER_EMAIL is
# the fallback for bids with no confirmed region.
# AIRTABLE_OWNER_NORTH_EMAIL=info@floorcoveringunlimited.com
# AIRTABLE_OWNER_SOUTH_EMAIL=robert@floorcoveringunlimited.com
