# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_CONTACTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BIDS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_FOLLOWUP_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Gmail (sender must match the OAuth account)
GMAIL_SENDER=you@gmail.com
GMAIL_RECIPIENTS=rep1@example.com,rep2@example.com
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# Dashboard (Next.js) — SUPABASE_URL / SUPABASE_KEY are set in Vercel.
# Optional: override the "Open Airtable" button target in the top nav.
# Defaults to the current team invite link (resolves only for people already
# granted access to the base).
NEXT_PUBLIC_AIRTABLE_URL=https://airtable.com/appXXXXXXXXXXXXXX
